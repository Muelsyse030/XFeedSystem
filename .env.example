# XFeedSystem 环境变量配置模板
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env
#
# 所有变量前缀: XFEED_
# 环境变量自动覆盖 configs/config.yaml 中对应的值
#
# 两种部署方式：
#   A) 二进制直接运行（systemd）：取消注释下方的 XFEED_ 变量，改为真实地址
#   B) Docker Compose 部署：XFEED_* 变量使用容器名（mysql/redis/meilisearch）

# ---- 服务器 ----
# XFEED_SERVER_PORT=8000

# ---- MySQL ----
# Docker 部署: root:yourpass@tcp(mysql:3306)/feed_system?...   ← 容器名 mysql
# 二进制部署:   root:yourpass@tcp(127.0.0.1:3306)/feed_system?...
XFEED_MYSQL_DSN=root:your_password@tcp(127.0.0.1:3306)/feed_system?charset=utf8mb4&parseTime=True&loc=Local

# ---- Redis ----
# Docker 部署: redis:6379
# 二进制部署:   127.0.0.1:6379
XFEED_REDIS_ADDR=127.0.0.1:6379
XFEED_REDIS_PASSWORD=
# XFEED_REDIS_DB=0

# ---- JWT ----
# 生产环境务必设置为随机长字符串（openssl rand -hex 32）
XFEED_JWT_SECRET=change-me-to-a-random-secret
# XFEED_JWT_EXPIRE_HOURS=72

# ---- 阿里云 OSS (对象存储) ----
# XFEED_OSS_ENABLE=true
# XFEED_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
# XFEED_OSS_BUCKET=your-bucket-name
XFEED_OSS_ACCESS_KEY_ID=your_oss_access_key_id
XFEED_OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
# XFEED_OSS_BASE_URL=https://your-bucket.oss-cn-beijing.aliyuncs.com

# ---- Meilisearch (全文搜索) ----
# Docker 部署: http://meilisearch:7700
# 二进制部署:   http://127.0.0.1:7700
XFEED_MEILISEARCH_HOST=http://127.0.0.1:7700
XFEED_MEILISEARCH_API_KEY=your_meilisearch_master_key

# ---- 以下仅供 Docker Compose 使用，二进制部署可忽略 ----
# MYSQL_ROOT_PASSWORD=your_mysql_root_password
# MEILI_MASTER_KEY=your_meilisearch_master_key
