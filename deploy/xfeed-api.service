[Unit]
Description=XFeedSystem API Service
After=network.target mysql.service redis.service

[Service]
Type=simple
User=xfeed
Group=xfeed
WorkingDirectory=/opt/xfeed
ExecStart=/opt/xfeed/xfeed-api
ExecStop=/bin/kill -SIGTERM $MAINPID
Restart=always
RestartSec=5

# 环境变量（也可用 EnvironmentFile 指向 /opt/xfeed/.env）
Environment=CONFIG_PATH=/opt/xfeed/configs

# 安全加固
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/xfeed /tmp

[Install]
WantedBy=multi-user.target
